# Server
PORT=8080

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/placement-portal?retryWrites=true&w=majority
MONGO_DATABASE=placement-portal

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_must_be_long_enough_for_hs256
JWT_EXPIRATION=2592000000

# ========================================================
# EMAIL CONFIGURATION (Choose Brevo OR Gmail)
# ========================================================

# OPTION 1: Brevo (Recommended for Cloud / Render)
# In Brevo Dashboard -> Settings -> SMTP & API:
# EMAIL_HOST_BREVO=smtp-relay.brevo.com
# EMAIL_PORT_BREVO=587
# EMAIL_USER_BREVO=your-brevo-smtp-login@smtp-brevo.com (or account email)
# EMAIL_PASS_BREVO=xsmtpsib-your-generated-smtp-key
# EMAIL_SENDER_BREVO=your-verified-sender@domain.com

# OPTION 2: Gmail SMTP
# Generate a 16-character App Password at: Google Account -> Security -> 2-Step Verification -> App Passwords
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-16-char-app-password
# EMAIL_SENDER=your-email@gmail.com

# AI & Admin
AI_API_KEY=your_groq_api_key
ADMIN_EMAILS=admin@example.com
SEED_DATA=false
